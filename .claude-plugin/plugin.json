{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "terser",
  "displayName": "Terser",
  "version": "1.2.0",
  "description": "Unified token-efficiency plugin combining a 6-tool AST Counter front door, 4-tier read funnel, lossless output compression, smart compaction, quality scoring, local dashboard, micro-skills, FormRepair, tool pruning, and loop guard.",
  "author": {
    "name": "Terser"
  },
  "license": "MIT",
  "commands": "./commands/",
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json",
  "keywords": [
    "tokens",
    "optimization",
    "ast",
    "context",
    "compression",
    "micro-skills",
    "tool-pruning",
    "mcp"
  ],
  "mcpServers": {
    "terser-index": {
      "command": "python3",
      "args": [
        "-E",
        "-s",
        "-X",
        "utf8",
        "${CLAUDE_PLUGIN_ROOT}/runtime/index_mcp.py"
      ],
      "env": {
        "TERSER_CLIENT_ID": "claude",
        "TERSER_TOOL_SURFACE": "counter"
      }
    }
  }
}
