#!/bin/sh
# Terser — POSIX hook launcher (native Rust fast-path with lazy Python fallback).
# Resolve paths with parameter expansion only: every `$(...)` is a fork, and forks cost
# 15-30ms each under Git Bash on Windows, on every single hook event.
case "$0" in
  */*) SCRIPT_DIR="${0%/*}" ;;
  *) SCRIPT_DIR="." ;;
esac
PLUGIN_ROOT="$SCRIPT_DIR/.."
HOOK_PY="$PLUGIN_ROOT/runtime/unified_hook.py"
FAST_BIN="$PLUGIN_ROOT/bin/terser-fast"
if [ "${1:-}" = "--host" ] && [ "${2:-}" = "codex" ]; then
  FAST_BIN="$PLUGIN_ROOT/bin/terser-codex"
  if [ -z "${TERSER_PYTHON:-}" ] && [ -f "$PLUGIN_ROOT/runtime/codex-python.txt" ]; then
    IFS= read -r TERSER_PYTHON < "$PLUGIN_ROOT/runtime/codex-python.txt"
  fi
  case "${4:-}" in
    PreToolUse|SubagentStart) ;;
    *) FAST_BIN="" ;;
  esac
fi

if [ -x "$FAST_BIN" ]; then
  if [ -n "${TERSER_PYTHON:-}" ] && [ -x "${TERSER_PYTHON}" ]; then
    exec "$FAST_BIN" --python "${TERSER_PYTHON}" --script "$HOOK_PY" "$@"
  fi
  exec "$FAST_BIN" --script "$HOOK_PY" "$@"
fi

PY_BIN=""
for py in "${TERSER_PYTHON:-}" python3 /usr/bin/python3 /usr/local/bin/python3 /opt/homebrew/bin/python3 python; do
  [ -n "$py" ] || continue
  if command -v "$py" >/dev/null 2>&1; then
    PY_BIN="$py"
    break
  fi
done

if [ -n "$PY_BIN" ]; then
  exec "$PY_BIN" -E -s -X utf8 "$HOOK_PY" "$@"
fi
exit 0
