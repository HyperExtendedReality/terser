{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event SessionStart",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event SubagentStart",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event SubagentStop",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event SubagentStop",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event UserPromptSubmit",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__(plugin_terser_)?terser[-_]index__(menu|route|order))$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event PreToolUse",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write|MultiEdit|NotebookEdit|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event PostToolUse",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event PostCompact",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event PostCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event Stop",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/terse-hook\" --host codex --event SessionEnd",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'scripts\\terse-hook.cmd') --host codex --event SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
